IDD_ABOUTBOX DIALOGEX 0, 0, 170, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "关于 WMRDemo"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDR_MAINFRAME,IDC_STATIC,14,14,21,20
    LTEXT           "WMRDemo，1.0 版",IDC_STATIC,42,14,114,8,SS_NOPREFIX
    LTEXT           "Copyright (C) 2015",IDC_STATIC,42,26,114,8
    DEFPUSHBUTTON   "确定",IDOK,113,41,50,14,WS_GROUP
END

IDD_WMRDEMO_DIALOG DIALOGEX 0, 0, 319, 207
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "WMRDemo"
FONT 9, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "打开设备",IDC_BUT_OPEN,19,19,50,14
    PUSHBUTTON      "关闭设备",IDC_BUT_CLOSE,82,19,50,14
    PUSHBUTTON      "开始注册",IDC_BUT_ENROLL,19,39,50,14
    PUSHBUTTON      "停止注册",IDC_BUT_STOPENROLL,82,39,50,14
    PUSHBUTTON      "开始比对",IDC_BUT_VERIFY,19,59,50,14
    PUSHBUTTON      "停止比对",IDC_BUT_STOPVERIFY,82,59,50,14
    EDITTEXT        IDC_EDIT1,14,122,129,71,ES_MULTILINE | ES_AUTOHSCROLL | WS_VSCROLL | WS_HSCROLL
    CONTROL         "",IDC_IMG,"Static",SS_BITMAP,154,26,13,12
    GROUPBOX        "图像显示",IDC_STATIC,148,15,164,178
    PUSHBUTTON      "响蜂鸣器",IDC_BUT_BEEP,19,99,50,14
    PUSHBUTTON      "图像转特征",IDC_BUT_BMP2FEA,19,79,50,14
    PUSHBUTTON      "保存图像",IDC_BUT_SAVEBMP,82,79,50,14
    PUSHBUTTON      "退出",IDC_BUT_EXIT,82,99,50,14
END


